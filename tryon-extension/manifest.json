{
  "manifest_version": 3,
  "name": "TryOn Extension",
  "description": "Extension for try-on demo",
  "version": "1.0",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "TryOn"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
